<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PurOrderMapper">

    <resultMap type="PurOrder" id="PurOrderResult">
        <result property="purchaseId"   column="purchase_id"   />
        <result property="purchaseNo"   column="purchase_no"   />
        <result property="supplier"     column="supplier"      />
        <result property="materialCode" column="material_code" />
        <result property="material"     column="material"      />
        <result property="spec"         column="spec"          />
        <result property="quantity"     column="quantity"      />
        <result property="weight"       column="weight"        />
        <result property="unitPrice"    column="unit_price"    />
        <result property="amount"       column="amount"        />
        <result property="purchaseDate" column="purchase_date" />
        <result property="expectDate"   column="expect_date"   />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectPurOrderVo">
        select purchase_id, purchase_no, supplier, material_code, material, spec, quantity, weight,
               unit_price, amount, purchase_date, expect_date, status,
               create_by, create_time, update_by, update_time, remark
        from pur_order
    </sql>

    <select id="selectPurOrderList" parameterType="PurOrder" resultMap="PurOrderResult">
        <include refid="selectPurOrderVo"/>
        <where>
            <if test="purchaseNo != null  and purchaseNo != ''"> and purchase_no like concat('%', #{purchaseNo}, '%')</if>
            <if test="supplier != null  and supplier != ''"> and supplier like concat('%', #{supplier}, '%')</if>
            <if test="materialCode != null  and materialCode != ''"> and material_code like concat('%', #{materialCode}, '%')</if>
            <if test="material != null  and material != ''"> and material like concat('%', #{material}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by purchase_id desc
    </select>

    <select id="selectPurOrderByPurchaseId" parameterType="Long" resultMap="PurOrderResult">
        <include refid="selectPurOrderVo"/>
        where purchase_id = #{purchaseId}
    </select>

    <select id="checkPurchaseNoUnique" parameterType="String" resultMap="PurOrderResult">
        <include refid="selectPurOrderVo"/>
        where purchase_no = #{purchaseNo} limit 1
    </select>

    <insert id="insertPurOrder" parameterType="PurOrder" useGeneratedKeys="true" keyProperty="purchaseId">
        insert into pur_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="purchaseNo != null and purchaseNo != ''">purchase_no,</if>
            <if test="supplier != null">supplier,</if>
            <if test="materialCode != null">material_code,</if>
            <if test="material != null">material,</if>
            <if test="spec != null">spec,</if>
            <if test="quantity != null">quantity,</if>
            <if test="weight != null">weight,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="amount != null">amount,</if>
            <if test="purchaseDate != null">purchase_date,</if>
            <if test="expectDate != null">expect_date,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="purchaseNo != null and purchaseNo != ''">#{purchaseNo},</if>
            <if test="supplier != null">#{supplier},</if>
            <if test="materialCode != null">#{materialCode},</if>
            <if test="material != null">#{material},</if>
            <if test="spec != null">#{spec},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="weight != null">#{weight},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="amount != null">#{amount},</if>
            <if test="purchaseDate != null">#{purchaseDate},</if>
            <if test="expectDate != null">#{expectDate},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePurOrder" parameterType="PurOrder">
        update pur_order
        set purchase_no = #{purchaseNo},
            supplier = #{supplier},
            material_code = #{materialCode},
            material = #{material},
            spec = #{spec},
            quantity = #{quantity},
            weight = #{weight},
            unit_price = #{unitPrice},
            amount = #{amount},
            purchase_date = #{purchaseDate},
            expect_date = #{expectDate},
            status = #{status},
            remark = #{remark},
            update_by = #{updateBy},
            update_time = sysdate()
        where purchase_id = #{purchaseId}
    </update>

    <update id="updatePurchaseStatus">
        update pur_order
        set status = #{status},
            update_by = #{updateBy},
            update_time = sysdate()
        where purchase_id = #{purchaseId}
    </update>

    <delete id="deletePurOrderByPurchaseIds" parameterType="String">
        delete from pur_order where purchase_id in
        <foreach item="purchaseId" collection="array" open="(" separator="," close=")">
            #{purchaseId}
        </foreach>
    </delete>
</mapper>
