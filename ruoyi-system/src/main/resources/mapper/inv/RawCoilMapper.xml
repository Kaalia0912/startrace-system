<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RawCoilMapper">

    <resultMap type="RawCoil" id="RawCoilResult">
        <result property="coilId"     column="coil_id"     />
        <result property="coilNo"     column="coil_no"     />
        <result property="supplier"   column="supplier"    />
        <result property="material"   column="material"    />
        <result property="spec"       column="spec"        />
        <result property="thickness"  column="thickness"   />
        <result property="width"      column="width"       />
        <result property="netWeight"  column="net_weight"  />
        <result property="hardness"   column="hardness"    />
        <result property="innerDia"   column="inner_dia"   />
        <result property="arriveDate" column="arrive_date" />
        <result property="location"   column="location"    />
        <result property="qcStatus"   column="qc_status"   />
        <result property="coilStatus" column="coil_status" />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectRawCoilVo">
        select coil_id, coil_no, supplier, material, spec, thickness, width, net_weight, hardness,
               inner_dia, arrive_date, location, qc_status, coil_status,
               create_by, create_time, update_by, update_time, remark
        from inv_raw_coil
    </sql>

    <select id="selectRawCoilList" parameterType="RawCoil" resultMap="RawCoilResult">
        <include refid="selectRawCoilVo"/>
        <where>
            <if test="coilNo != null  and coilNo != ''"> and coil_no like concat('%', #{coilNo}, '%')</if>
            <if test="supplier != null  and supplier != ''"> and supplier like concat('%', #{supplier}, '%')</if>
            <if test="material != null  and material != ''"> and material like concat('%', #{material}, '%')</if>
            <if test="qcStatus != null  and qcStatus != ''"> and qc_status = #{qcStatus}</if>
            <if test="coilStatus != null  and coilStatus != ''"> and coil_status = #{coilStatus}</if>
        </where>
        order by coil_no
    </select>

    <select id="selectRawCoilByCoilId" parameterType="Long" resultMap="RawCoilResult">
        <include refid="selectRawCoilVo"/>
        where coil_id = #{coilId}
    </select>

    <select id="checkCoilNoUnique" parameterType="String" resultMap="RawCoilResult">
        <include refid="selectRawCoilVo"/>
        where coil_no = #{coilNo} limit 1
    </select>

    <insert id="insertRawCoil" parameterType="RawCoil" useGeneratedKeys="true" keyProperty="coilId">
        insert into inv_raw_coil
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="coilNo != null and coilNo != ''">coil_no,</if>
            <if test="supplier != null">supplier,</if>
            <if test="material != null">material,</if>
            <if test="spec != null">spec,</if>
            <if test="thickness != null">thickness,</if>
            <if test="width != null">width,</if>
            <if test="netWeight != null">net_weight,</if>
            <if test="hardness != null">hardness,</if>
            <if test="innerDia != null">inner_dia,</if>
            <if test="arriveDate != null">arrive_date,</if>
            <if test="location != null">location,</if>
            <if test="qcStatus != null">qc_status,</if>
            <if test="coilStatus != null">coil_status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="coilNo != null and coilNo != ''">#{coilNo},</if>
            <if test="supplier != null">#{supplier},</if>
            <if test="material != null">#{material},</if>
            <if test="spec != null">#{spec},</if>
            <if test="thickness != null">#{thickness},</if>
            <if test="width != null">#{width},</if>
            <if test="netWeight != null">#{netWeight},</if>
            <if test="hardness != null">#{hardness},</if>
            <if test="innerDia != null">#{innerDia},</if>
            <if test="arriveDate != null">#{arriveDate},</if>
            <if test="location != null">#{location},</if>
            <if test="qcStatus != null">#{qcStatus},</if>
            <if test="coilStatus != null">#{coilStatus},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateRawCoil" parameterType="RawCoil">
        update inv_raw_coil
        set coil_no = #{coilNo},
            supplier = #{supplier},
            material = #{material},
            spec = #{spec},
            thickness = #{thickness},
            width = #{width},
            net_weight = #{netWeight},
            hardness = #{hardness},
            inner_dia = #{innerDia},
            arrive_date = #{arriveDate},
            location = #{location},
            qc_status = #{qcStatus},
            coil_status = #{coilStatus},
            remark = #{remark},
            update_by = #{updateBy},
            update_time = sysdate()
        where coil_id = #{coilId}
    </update>

    <delete id="deleteRawCoilByCoilIds" parameterType="String">
        delete from inv_raw_coil where coil_id in
        <foreach item="coilId" collection="array" open="(" separator="," close=")">
            #{coilId}
        </foreach>
    </delete>
</mapper>
