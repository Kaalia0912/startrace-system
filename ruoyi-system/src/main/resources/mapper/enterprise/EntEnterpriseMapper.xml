    <select id="selectSummary" resultType="java.util.Map">
        select count(*) as total, ifnull(sum(registered_capital),0) as totalCapital, ifnull(round(avg(employee_count),0),0) as avgEmployee, count(distinct industry) as industryCount from ent_enterprise
