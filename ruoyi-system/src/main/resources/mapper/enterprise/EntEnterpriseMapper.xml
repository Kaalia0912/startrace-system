    <delete id="deleteEntEnterpriseByEntId" parameterType="Long">
        delete from ent_enterprise where ent_id = #{entId}
    </delete>

    <delete id="deleteEntEnterpriseByEntIds" parameterType="String">
        delete from ent_enterprise where ent_id in 
        <foreach item="entId" collection="array" open="(" separator="," close=")">
            #{entId}
        </foreach>
    </delete>

    <select id="checkEntCodeUnique" parameterType="String" resultMap="EntEnterpriseResult">
        <include refid="selectEntEnterpriseVo"/>
        where ent_code = #{entCode} limit 1
    </select>

    <select id="selectCountByEntType" resultType="java.util.Map">
        select ent_type as "name", count(*) as "value" from ent_enterprise group by ent_type
    </select>

    <select id="selectCountByIndustry" resultType="java.util.Map">
        select industry as "name", count(*) as "value" from ent_enterprise group by industry
