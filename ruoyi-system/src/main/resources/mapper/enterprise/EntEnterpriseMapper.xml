    <sql id="selectEntEnterpriseVo">
        select ent_id, ent_code, ent_name, industry, ent_type, scale, address, legal_person, phone, email, establish_date, registered_capital, employee_count, status, invoice_title, tax_no, invoice_address, invoice_phone, bank_name, bank_account, payment_days, credit_limit, default_address, create_by, create_time, update_by, update_time, remark from ent_enterprise
    </sql>

    <select id="selectEntEnterpriseList" parameterType="EntEnterprise" resultMap="EntEnterpriseResult">
        <include refid="selectEntEnterpriseVo"/>
        <where>  
            <if test="entCode != null  and entCode != ''"> and ent_code = #{entCode}</if>
            <if test="entName != null  and entName != ''"> and ent_name like concat('%', #{entName}, '%')</if>
            <if test="industry != null  and industry != ''"> and industry = #{industry}</if>
            <if test="entType != null  and entType != ''"> and ent_type = #{entType}</if>
            <if test="scale != null  and scale != ''"> and scale = #{scale}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="legalPerson != null  and legalPerson != ''"> and legal_person = #{legalPerson}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="establishDate != null "> and establish_date = #{establishDate}</if>
            <if test="registeredCapital != null "> and registered_capital = #{registeredCapital}</if>
            <if test="employeeCount != null "> and employee_count = #{employeeCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectEntEnterpriseByEntId" parameterType="Long" resultMap="EntEnterpriseResult">
        <include refid="selectEntEnterpriseVo"/>
        where ent_id = #{entId}
    </select>

